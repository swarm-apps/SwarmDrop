{
  "compilerOptions": {
    "target": "ES2022",
    // 只给 ES2022，**故意不给 DOM / node types**——这是「零平台依赖」的一半门禁。
    // 另一半是 scripts/check-shared-view-imports.mjs。理由与边界见 README.md。
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src"]
}
