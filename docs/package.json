{
  "name": "@swarmdrop/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "lingui compile --typescript && next build",
    "dev": "next dev",
    "start": "serve out",
    "typecheck": "fumadocs-mdx && lingui compile --typescript && next typegen && tsc --noEmit",
    "build:wasm": "wasm-pack build ../crates/web --target web --release --out-dir ../../packages/swarmdrop-web",
    "postinstall": "fumadocs-mdx && lingui compile --typescript",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --typescript",
    "test": "vitest run"
  },
  "dependencies": {
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@orama/orama": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "@swarm-hive/sdk": "^0.2.0",
    "@swarmdrop/shared-view": "link:../packages/shared-view",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.10",
    "fumadocs-ui": "16.9.3",
    "lucide-react": "^0.563.0",
    "mermaid": "^11.4.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "swarmdrop-web": "link:../packages/swarmdrop-web",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@lingui/cli": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@lingui/swc-plugin": "^6.6.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.15",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
